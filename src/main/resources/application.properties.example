spring.application.name=money_manager_backend

security.jwt.secret= your_jwt_secret_key_here
security.jwt.ttl-seconds=86400

spring.datasource.url= your_database_url_here
spring.datasource.username= your_database_username_here
spring.datasource.password= your_database_password_here
spring.jpa.hibernate.ddl-auto=validate (use 'update' for development)
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.clean-disabled=false
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.repair-on-migrate=true

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username= your_mail_username_here
spring.mail.password= your_mail_password_here
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true